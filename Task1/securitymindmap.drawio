        </mxCell>
        <mxCell id="8j1b3bDAzkfR5HRVkkHP-50" value="потеря данных" style="rounded=1;whiteSpace=wrap;html=1;" parent="8j1b3bDAzkfR5HRVkkHP-47" vertex="1">
